<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Haptic alerts (FR 5.2). Normal permission: granted at install, no runtime prompt. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        MAVLink over UDP. This is a normal permission: granted at install, never prompted for.

        It is easy to think it is only needed for HTTP, and it is not — binding a DatagramSocket
        requires it too, and without it `UdpTelemetryTransport.open()` throws a SecurityException
        that reads like a socket problem rather than a manifest one. Nothing is sent from here;
        the permission covers the socket either way.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Not required, and that is deliberate.

        The app talks to the flight controller over a USB-UART adapter, so on the target
        hardware — a Skydroid G20 with a GR01 link — this device is always present. Declaring
        it required would be true about the G20 and false about everything else: the simulator
        runs anywhere, and the telemetry pipeline above the transport is the part a reviewer
        will actually look at. A device without USB host gets the demo and a transport that
        reports no adapter, which is a legible failure rather than an install the store refuses.

        There is no matching <uses-permission>: USB access is granted per device at runtime,
        through the dialog UsbSerialTransport raises, not through the manifest.
    -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <application
        android:name=".BatteryAlertApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BatteryAlertSystem">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.BatteryAlertSystem">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
